# Supabase (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps (à activer lors de l'intégration des points de collecte / Places Autocomplete)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# PayTech
# NE JAMAIS mettre les clés secrètes PayTech ici : toute variable préfixée
# EXPO_PUBLIC_ est embarquée dans le bundle client et donc publique.
# Les clés PAYTECH_API_KEY / PAYTECH_SECRET_KEY doivent être configurées
# comme secrets d'Edge Functions Supabase, par ex. :
#   supabase secrets set PAYTECH_API_KEY=xxx PAYTECH_SECRET_KEY=xxx
